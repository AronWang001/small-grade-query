Options -Indexes

<FilesMatch "^\.env|^data\.json$|^(AGENTS|CHANGELOG|README)\.md$">
    Require all denied
</FilesMatch>

RewriteEngine On
RewriteRule ^(?:config|database|storage|tools|vendor|app|deploy)(?:/|$) - [F,L,NC]

Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "strict-origin-when-cross-origin"

